{
  "name": "dsh-memory-switch",
  "version": "0.1.0",
  "private": true,
  "description": "记忆开关: a per-conversation switch that cuts every cross-conversation memory channel for that conversation (history search, cross-conversation references, long-term memory read/write)",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/host.test.mjs tests/client.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "memory",
    "privacy",
    "记忆"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kingzhoudk/dsh-memory-switch.git"
  },
  "homepage": "https://github.com/Kingzhoudk/dsh-memory-switch#readme",
  "bugs": {
    "url": "https://github.com/Kingzhoudk/dsh-memory-switch/issues"
  }
}
